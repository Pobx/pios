# Copy to deploy/.env for local development. Values below are dev-only; never reuse in production.
POSTGRES_USER=otp
POSTGRES_PASSWORD=otp_dev_password
POSTGRES_DB=otp
POSTGRES_PORT=5432
KEYCLOAK_DB=keycloak

# Gateway
GATEWAY_PORT=80

# Keycloak (dev). KEYCLOAK_PUBLIC_URL is the EXTERNAL (browser-facing) base URL and defines the token issuer.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
KEYCLOAK_PORT=8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=otp

# Backend
BACKEND_DEBUG_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost
KEYCLOAK_AUDIENCE=otp-api

# Frontend runtime config (rendered into /config.js at container start)
KEYCLOAK_CLIENT_ID=otp-web
